# Experience Zone (homepage live mini demos: DOK, Code, Kasih)
# Off unless set to "true". Flip to anything else to switch the live AI off instantly.
EXPERIENCE_AI_ENABLED=false
# A dedicated OpenAI project key with a monthly spend cap. Never the production DOK key.
EXPERIENCE_OPENAI_API_KEY=
# Any OpenAI model that supports Structured Outputs (json_schema). Default: gpt-5 (stronger = fewer wrong codes).
EXPERIENCE_AI_MODEL=
# Used once if the model above is not available on this key. Default: gpt-4.1
EXPERIENCE_AI_FALLBACK_MODEL=
# Reasoning effort for gpt-5 / o-series models: minimal, low, medium, high. Default: low (keeps runs well under 60 s).
EXPERIENCE_AI_REASONING=
# Live runs per visitor per day (all demos together) and for the whole site per day.
EXPERIENCE_IP_DAILY_LIMIT=9
EXPERIENCE_DAILY_CAP=300
# Salt for hashing visitor IPs in the rate limiter (any long random string).
EXPERIENCE_HASH_SALT=

# Rate-limit store: Upstash Redis or Vercel KV (REST). Without it, limits are per server instance only.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Cloudflare Turnstile (free bot check). When the secret is set, every live run must pass it.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
